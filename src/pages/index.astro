---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
const monthFormatter = new Intl.DateTimeFormat("pt-PT", { month: "long" });
const monthKey = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
const archive = posts.reduce<Record<string, Record<string, typeof posts>>>((years, post) => {
	const year = String(post.data.pubDate.getFullYear());
	const month = monthKey(post.data.pubDate);
	(years[year] ??= {});
	(years[year][month] ??= []).push(post);
	return years;
}, {});
const currentYear = new Date().getFullYear();
const excerpt = (post: (typeof posts)[number]) => post.data.description || "Uma nota do arquivo pessoal.";
---
<!doctype html>
<html lang="pt-PT">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="page-title">
				<h1 id="page-title">My brain&apos;s backup, ideias and thoughts.</h1>
				<form class="search-wrap" id="search-form" role="search">
					<label class="sr-only" for="post-search">Pesquisar textos</label>
					<input class="search" id="post-search" type="search" placeholder="Pesquisar textos..." autocomplete="off" />
					<button type="submit" aria-label="Pesquisar">⌕</button>
				</form>
			</section>
			<div class="content-grid">
				<section class="posts-column" aria-label="Publicações">
					<div id="post-list">
						{posts.map((post) => (
							<article class="post-preview" data-search={`${post.data.title} ${excerpt(post)} ${(post.data.tags ?? []).join(" ")}`.toLowerCase()} data-year={post.data.pubDate.getFullYear()} data-month={monthKey(post.data.pubDate)}>
								<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
								<h2><a href={`${base}${post.id.replace(/^\/+/, "")}/`}>{post.data.title}</a></h2>
								<p class="post-excerpt">{excerpt(post)}</p>
								{post.data.tags && <ul class="tags" aria-label="Etiquetas">{post.data.tags.map((tag) => <li><button type="button" data-tag={tag}>{tag}</button></li>)}</ul>}
							</article>
						))}
					</div>
					<p class="empty-state" hidden>Nenhum texto encontrado.</p>
				</section>
				<aside class="archive" aria-labelledby="archive-title">
					<h2 id="archive-title">ARQUIVO</h2>
					{Object.entries(archive).sort(([a], [b]) => Number(b) - Number(a)).map(([year, months]) => (
						<details class="year-group" open={Number(year) === currentYear}>
							<summary><span>{year}</span><span class="count">{Object.values(months).flat().length}<b aria-hidden="true"></b></span></summary>
							<div class="months">
								{Object.entries(months).sort(([a], [b]) => b.localeCompare(a)).map(([key, monthPosts]) => <button type="button" data-filter-month={key}><span>{monthFormatter.format(monthPosts[0].data.pubDate)}</span><span>{monthPosts.length}</span></button>)}
							</div>
						</details>
					))}
				</aside>
			</div>
		</main>
		<Footer />
		<script>
			const input = document.querySelector<HTMLInputElement>("#post-search");
			const form = document.querySelector<HTMLFormElement>("#search-form");
			const cards = [...document.querySelectorAll<HTMLElement>(".post-preview")];
			const empty = document.querySelector<HTMLElement>(".empty-state");
			let activeMonth = "";
			const filter = (query = input?.value.trim().toLowerCase() ?? "") => { let visible = 0; cards.forEach((card) => { const show = (!query || card.dataset.search?.includes(query)) && (!activeMonth || card.dataset.month === activeMonth); card.hidden = !show; if (show) visible++; }); if (empty) empty.hidden = visible > 0; };
			input?.addEventListener("input", () => filter());
			form?.addEventListener("submit", (event) => { event.preventDefault(); filter(); });
			document.querySelectorAll<HTMLButtonElement>("[data-filter-month]").forEach((button) => button.addEventListener("click", () => { activeMonth = button.dataset.filterMonth ?? ""; filter(); }));
			document.querySelectorAll<HTMLButtonElement>("[data-tag]").forEach((button) => button.addEventListener("click", () => { if (input) input.value = button.dataset.tag ?? ""; activeMonth = ""; filter(); }));
		</script>
	</body>
</html>
