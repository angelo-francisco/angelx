---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { postURL, monthKey, monthName } from "../lib/posts";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="home">
    <Header />
    <main id="main-content">
      <section class="hero">
        <h1>
          My brain’s backup,
          <br />
          <em>ideias and thoughts.</em>
        </h1>
        <form class="search-wrap" role="search">
          <label class="sr-only" for="post-search">
            Pesquisar no blog
          </label>
          <input
            id="post-search"
            type="search"
            placeholder="Pesquisar no blog..."
          />
          <button aria-label="Pesquisar">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="10" cy="10" r="6" />
              <path d="m15 15 5 5" />
            </svg>
          </button>
        </form>
      </section>
      <div class="content-grid">
        <section class="posts-column" aria-label="Últimos textos">
          <h2 class="eyebrow">Últimos textos</h2>
          {posts.map((post) => (
            <article
              class="post-preview"
              data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`.toLocaleLowerCase(
                "pt-PT",
              )}
              data-month={monthKey(post.data.pubDate)}
              data-tags={JSON.stringify(post.data.tags)}
            >
              <p class="post-date">
                <FormattedDate date={post.data.pubDate} />
              </p>
              <div>
                <h2>
                  <a href={postURL(post.id)}>{post.data.title}</a>
                </h2>
                <p class="post-excerpt">{post.data.description}</p>
                <ul class="tags">
                  {post.data.tags.map((tag) => (
                    <li>
                      <button type="button" data-tag={tag}>
                        #{tag}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
          <p class="empty-state" hidden>
            Nenhum texto encontrado.
          </p>
        </section>
        <aside class="archive">
          <h2 class="eyebrow">
            <a
              href={`${import.meta.env.BASE_URL.replace(/\/$/, "") + "/"}archive/`}
            >
              Arquivo
            </a>
          </h2>
          {years.map((year, i) => (
            <details class="year-group" open={i === 0}>
              <summary>
                {year}{" "}
                <span>
                  (
                  {
                    posts.filter(
                      (p) => p.data.pubDate.getUTCFullYear() === year,
                    ).length
                  }
                  )
                </span>
                <b aria-hidden="true">⌄</b>
              </summary>
              <div class="months">
                {[
                  ...new Set(
                    posts
                      .filter((p) => p.data.pubDate.getUTCFullYear() === year)
                      .map((p) => monthKey(p.data.pubDate)),
                  ),
                ].map((month) => (
                  <button type="button" data-filter-month={month}>
                    {monthName(
                      posts.find((p) => monthKey(p.data.pubDate) === month)!
                        .data.pubDate,
                    )}{" "}
                    (
                    {
                      posts.filter((p) => monthKey(p.data.pubDate) === month)
                        .length
                    }
                    )
                  </button>
                ))}
              </div>
            </details>
          ))}
          <button class="reset-filter" type="button">
            Ver todos os textos ↗
          </button>
        </aside>
      </div>
    </main>
    <Footer />
    <script>
      const input = document.querySelector<HTMLInputElement>("#post-search")!;
      const cards = [
        ...document.querySelectorAll<HTMLElement>(".post-preview"),
      ];
      let month = "";
      let activeTag = "";
      function filter() {
        let count = 0;
        const query = input.value.trim().toLocaleLowerCase("pt-PT");
        cards.forEach((card) => {
          card.hidden = !(
            card.dataset.search?.includes(query) &&
            (!month || card.dataset.month === month) &&
            (!activeTag ||
              JSON.parse(card.dataset.tags ?? "[]").includes(activeTag))
          );
          if (!card.hidden) count++;
        });
        document.querySelector<HTMLElement>(".empty-state")!.hidden = count > 0;
      }
      input.addEventListener("input", () => {
        activeTag = "";
        filter();
      });
      document.querySelector("form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        filter();
      });
      document
        .querySelectorAll<HTMLButtonElement>("[data-filter-month]")
        .forEach((button) =>
          button.addEventListener("click", () => {
            month =
              month === button.dataset.filterMonth
                ? ""
                : button.dataset.filterMonth!;
            filter();
          }),
        );
      document
        .querySelectorAll<HTMLButtonElement>("[data-tag]")
        .forEach((button) =>
          button.addEventListener("click", () => {
            activeTag = button.dataset.tag!;
            input.value = "";
            month = "";
            filter();
          }),
        );
      document.querySelector(".reset-filter")?.addEventListener("click", () => {
        input.value = "";
        activeTag = "";
        month = "";
        filter();
      });
    </script>
  </body>
</html>
