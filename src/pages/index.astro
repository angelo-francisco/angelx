---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-PT">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			section {
				display: flex;
				flex-direction: column;
				padding: 1em 0;
				margin: 0;
				gap: 1rem;
			}

			section a {
				display: flex;
				justify-content: space-between;
				align-items: center;
				text-decoration: none;
				padding: 0.2em 0;
				border-bottom: solid 1px rgb(196, 196, 196);
				min-width: 0;
			}

			section h4 {
				margin: 0;
				font-weight: 400;
				transition: color 10ms ease;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			section h4:hover {
				color: #043b9c;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h2>Hello, I'm Ângelo Francisco!</h2>
			<p style="text-align: left;">
				And i decided to create a site to document my academic and professional
				life, sometimes I'll also share interesting personal histories. So...
				Welcome to my brains backup.
			</p>

			<section>
				{
					posts.map((post) => (
						<a href={`${SITE_URL}${post.id}/`}>
							<h5 class="title">{post.data.title}</h5>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
