---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const months = new Intl.DateTimeFormat("pt-PT", { month: "long" });
const currentYear = new Date().getFullYear();
const archive = posts.reduce<Record<string, typeof posts>>((groups, post) => {
	const year = String(post.data.pubDate.getFullYear());
	(groups[year] ??= []).push(post);
	return groups;
}, {});
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pt-PT">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home-layout { display: grid; grid-template-columns: minmax(0, 1fr) 270px; gap: 4rem; align-items: start; }
			.eyebrow, .archive-label, .side-label { color: var(--accent); font: 700 .75rem/1.2 monospace; letter-spacing: .12em; text-transform: uppercase; }
			.intro { max-width: 570px; font-size: 1.18rem; color: var(--muted); }
			.archive-section { display: flex; flex-direction: column; padding-top: 2.5rem; gap: 1rem; }
			.archive-label { color: var(--muted); }
			.archive-group { border: 1px solid var(--border); background: var(--paper-dark); box-shadow: 5px 5px 0 var(--shadow); animation: archive-in .65s cubic-bezier(.22, 1, .36, 1) both; } .archive-group:nth-of-type(3) { animation-delay: .08s; } .archive-group:nth-of-type(4) { animation-delay: .16s; } @keyframes archive-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
			.archive-group summary { cursor: pointer; list-style: none; padding: 1rem 1.2rem; display: flex; justify-content: space-between; align-items: center; font: 800 1.3rem monospace; color: var(--accent); }
			.archive-group summary::-webkit-details-marker { display: none; }
			.archive-group summary::after { content: "+"; font-weight: 400; }
			.archive-group[open] summary::after { content: "−"; }
			.post-list { padding: 0 1.2rem 1rem; }
			.post-list a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; text-decoration: none; padding: .85rem 0; border-top: 1px dashed var(--border); min-width: 0; }
			.post-list h3 { margin: 0; font-size: 1.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.post-list h3::before { content: "↳ "; color: var(--accent); }
			.archive-month, .post-list .date { margin: 0; color: var(--muted); font: .72rem monospace; text-transform: capitalize; white-space: nowrap; }
			.sidebar { position: sticky; top: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
			.side-card { border: 1px solid var(--border); padding: 1.2rem; background: var(--paper-dark); box-shadow: 5px 5px 0 var(--shadow); }
			.search { width: 100%; margin-top: .8rem; padding: .7rem .75rem; border: 1px solid var(--border); border-radius: 0; color: var(--ink); background: var(--paper); font: .9rem monospace; }
			.quick-links { display: flex; flex-direction: column; gap: .6rem; margin: .8rem 0 0; padding: 0; list-style: none; }
			.quick-links a { display: block; color: var(--ink); text-decoration: none; font-size: .95rem; line-height: 1.25; }
			.quick-links a:hover { color: var(--accent); }
			.no-results { display: none; color: var(--muted); font: .85rem monospace; }
			@media (max-width: 800px) { .home-layout { display: block; } .sidebar { position: static; margin-top: 3rem; } }
			@media (max-width: 520px) { .post-list a { align-items: flex-start; flex-direction: column; gap: .2rem; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="home-layout">
				<div>
					<p class="eyebrow">notas de um cérebro em movimento · edição 01</p>
					<h1>Um arquivo pessoal<br /><em>para ideias soltas.</em></h1>
					<p class="intro">Bem-vindo ao meu pequeno canto da internet. Aqui guardo aprendizados, histórias e perguntas que ainda não têm resposta.</p>
					<section class="archive-section" aria-labelledby="archive-heading">
						<p id="archive-heading" class="archive-label">arquivo / navegar por data</p>
						{Object.entries(archive).map(([year, yearPosts]) => (
							<details class="archive-group" open={Number(year) === currentYear}>
								<summary>{year}<span>{yearPosts.length} {yearPosts.length === 1 ? "nota" : "notas"}</span></summary>
								<div class="post-list">
									{yearPosts.map((post) => (
										<a class="post-link" data-search={`${post.data.title} ${months.format(post.data.pubDate)} ${year}`.toLowerCase()} href={`${base}${post.id.replace(/^\/+/, "")}/`}>
											<div><p class="archive-month">{months.format(post.data.pubDate)}</p><h3>{post.data.title}</h3></div>
											<p class="date"><FormattedDate date={post.data.pubDate} /></p>
										</a>
									))}
								</div>
							</details>
						))}
						<p class="no-results">Nenhuma nota encontrada.</p>
					</section>
				</div>
				<aside class="sidebar" aria-label="Ferramentas do arquivo">
					<div class="side-card"><p class="side-label">pesquisar no arquivo</p><label class="sr-only" for="post-search">Pesquisar posts</label><input class="search" id="post-search" type="search" placeholder="ex.: consistência" /></div>
					<div class="side-card"><p class="side-label">títulos recentes</p><ul class="quick-links">{posts.slice(0, 5).map((post) => <li><a href={`${base}${post.id.replace(/^\/+/, "")}/`}>{post.data.title}</a></li>)}</ul></div>
				</aside>
			</div>
		</main>
		<Footer />
		<script>
			const search = document.querySelector<HTMLInputElement>("#post-search");
			const links = [...document.querySelectorAll<HTMLElement>(".post-link")];
			const empty = document.querySelector<HTMLElement>(".no-results");
			search?.addEventListener("input", () => { const query = search.value.trim().toLowerCase(); let visible = 0; links.forEach((link) => { const match = !query || link.dataset.search?.includes(query); link.hidden = !match; if (match) visible++; }); if (empty) empty.style.display = visible ? "none" : "block"; });
		</script>
	</body>
</html>
