---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-PT">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.eyebrow { color: var(--accent); font: 700 .78rem/1.2 monospace; letter-spacing: .12em; text-transform: uppercase; }
			.intro { max-width: 570px; font-size: 1.18rem; color: var(--muted); }
			section { display: flex; flex-direction: column; padding: 2rem 0 0; margin: 0; gap: 0; }
			section::before { content: "arquivo / textos recentes"; color: var(--muted); font: 700 .75rem monospace; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .8rem; }
			section a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; text-decoration: none; padding: 1rem 0; border-top: 2px solid var(--ink); min-width: 0; }
			section a:last-child { border-bottom: 2px solid var(--ink); }
			section h5 { margin: 0; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			section h5::before { content: "↳ "; color: var(--accent); }
			section .date { margin: 0; color: var(--muted); font: .75rem monospace; white-space: nowrap; }
			@media (max-width: 520px) { section a { align-items: flex-start; flex-direction: column; gap: .2rem; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">notas de um cérebro em movimento · edição 01</p>
			<h1>Um arquivo pessoal<br /><em>para ideias soltas.</em></h1>
			<p class="intro">
				Bem-vindo ao meu pequeno canto da internet. Aqui guardo aprendizados,
				histórias e perguntas que ainda não têm resposta.
			</p>

			<section>
				{
					posts.map((post) => (
						<a href={`${SITE_URL}${post.id}/`}>
							<h5 class="title">{post.data.title}</h5>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
