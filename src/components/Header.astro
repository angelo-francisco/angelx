---
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
	<a class="brand" href={base}>Ângelo Francisco</a>
	<nav class="site-nav" aria-label="Ligações externas">
		<a href="https://github.com/angelo-francisco" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">◉</span></a>
		<span class="nav-divider" aria-hidden="true"></span>
		<a href={`${base}rss.xml`}>RSS <span aria-hidden="true">◔</span></a>
		<span class="nav-divider" aria-hidden="true"></span>
		<a href="https://www.linkedin.com/in/angelo-francisco/" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">▣</span></a>
	</nav>
</header>
<style>
	.site-header { display:flex; justify-content:space-between; align-items:center; gap:2rem; width:100%; max-width:1250px; margin:0 auto; padding:1rem 0; border-bottom:1px solid var(--border); }
	.brand { color:var(--ink); font:1.55rem/1.1 Newsreader, Georgia, serif; text-decoration:none; }
	.site-nav { display:flex; align-items:center; gap:1rem; font:0.78rem/1 IBM Plex Mono, monospace; }
	.site-nav a { color:var(--ink); text-decoration:none; transition:color .2s ease; }
	.site-nav a:hover { color:var(--accent); }
	.site-nav span[aria-hidden] { font-size:.9rem; margin-left:.25rem; }
	.nav-divider { width:1px; height:1.2rem; background:var(--border); }
	@media (max-width:700px) { .site-header { padding:1rem; } .brand { font-size:1.3rem; } .site-nav { gap:.65rem; font-size:.68rem; } .site-nav span[aria-hidden] { display:none; } }
</style>
