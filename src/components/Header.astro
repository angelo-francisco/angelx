<style>
	.floating-nav-wrap { position: fixed; z-index: 10; right: 0; bottom: 1.25rem; left: 0; display: flex; justify-content: center; pointer-events: none; }
	.floating-nav { display: flex; align-items: center; gap: .25rem; width: max-content; padding: .4rem; border: 1px solid color-mix(in srgb, var(--border) 75%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--paper) 88%, transparent); box-shadow: 0 10px 30px color-mix(in srgb, var(--ink) 16%, transparent); backdrop-filter: blur(14px); pointer-events: auto; }
	.nav-item { display: flex; align-items: center; gap: 0; width: 2.75rem; height: 2.75rem; overflow: hidden; padding: 0 .75rem; border: 0; border-radius: 999px; color: var(--ink); background: transparent; text-decoration: none; white-space: nowrap; cursor: pointer; font: inherit; transition: width .25s ease, gap .25s ease, color .2s ease, background .2s ease; }
	.nav-item:hover, .nav-item:focus-visible { width: 7.2rem; gap: .55rem; color: var(--accent); background: var(--paper-dark); outline: none; }
	.nav-item svg { flex: 0 0 1.25rem; width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
	.nav-item span { transform: translateX(-.5rem); opacity: 0; transition: transform .25s ease, opacity .2s ease; }
	.nav-item:hover span, .nav-item:focus-visible span { transform: translateX(0); opacity: 1; }
	@media (max-width: 520px) { .floating-nav-wrap { bottom: .75rem; } .floating-nav { gap: 0; } .nav-item { width: 2.55rem; height: 2.55rem; padding: 0 .65rem; } .nav-item:hover, .nav-item:focus-visible { width: 6.4rem; } }
</style>
<script>
	const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
	toggle?.addEventListener("click", () => {
		const isDark = document.documentElement.dataset.theme === "dark";
		document.documentElement.dataset.theme = isDark ? "light" : "dark";
		toggle.setAttribute("aria-pressed", String(!isDark));
		toggle.setAttribute("aria-label", isDark ? "Mudar para tema escuro" : "Mudar para tema claro");
	});
</script>
