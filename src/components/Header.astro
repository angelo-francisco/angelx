---
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
	<a class="brand" href={base}>Ângelx <span>arquivo pessoal</span></a>
	<button class="menu-toggle" type="button" aria-expanded="true" aria-controls="main-nav">☰ <span>modo compacto</span></button>
	<nav id="main-nav" class="site-nav" aria-label="Navegação principal">
		<a href={base}>Início</a><a href={`${base}about/`}>Sobre mim</a><a href="https://github.com/angelo-francisco" target="_blank" rel="noreferrer">GitHub</a>
		<button class="theme-toggle" type="button" aria-label="Mudar para tema escuro" aria-pressed="false">Tema</button>
	</nav>
</header>
<style>
	.site-header { position: sticky; top: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; gap: 1rem; width: 100%; padding: 1rem max(1rem, calc((100% - 1120px) / 2)); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(12px); }
	.brand { color: var(--ink); text-decoration: none; font: 800 1.15rem monospace; } .brand span { display: block; color: var(--muted); font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
	.site-nav { display: flex; align-items: center; gap: 1.25rem; } .site-nav a, .theme-toggle, .menu-toggle { color: var(--ink); background: transparent; border: 0; font: .78rem monospace; text-decoration: none; cursor: pointer; } .site-nav a:hover, .theme-toggle:hover { color: var(--accent); }
	.menu-toggle { order: 2; display: flex; gap: .45rem; align-items: center; color: var(--accent); } .menu-toggle span { font-size: .65rem; text-transform: uppercase; }
	.site-header.compact .site-nav { display: none; } .site-header.compact .menu-toggle span { display: none; }
	@media (max-width: 650px) { .site-header { flex-wrap: wrap; } .site-nav { order: 3; width: 100%; justify-content: space-between; gap: .5rem; } }
</style>
<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const menu = document.querySelector<HTMLButtonElement>(".menu-toggle");
	menu?.addEventListener("click", () => { const compact = header?.classList.toggle("compact") ?? false; menu.setAttribute("aria-expanded", String(!compact)); menu.querySelector("span")!.textContent = compact ? "abrir navegação" : "modo compacto"; });
	const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
	toggle?.addEventListener("click", () => { const isDark = document.documentElement.dataset.theme === "dark"; document.documentElement.dataset.theme = isDark ? "light" : "dark"; toggle.setAttribute("aria-pressed", String(!isDark)); toggle.setAttribute("aria-label", isDark ? "Mudar para tema escuro" : "Mudar para tema claro"); });
</script>
